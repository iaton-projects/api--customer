<configuration>
    <include resource="org/springframework/boot/logging/logback/default.xml"/>
    <springProfile name="jsonlog">
        <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>
                    { "timestamp": "%d{yyyy-MM-dd'T'HH:mm:ss.SSS}", "service" : "api--customer", "level": "%p", "trace": "%X{traceId:-}", "span": "%X{spanId:-}", "class": "%logger{40}", "message": "%msg" }
                </pattern>
            </encoder>
        </appender>
    </springProfile>
    <root level="info">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>